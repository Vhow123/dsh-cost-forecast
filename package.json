  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "index.js",
    "holidays.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
