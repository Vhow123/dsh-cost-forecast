    "token-usage"
  ],
  "license": "MIT",
  "author": "Vhow123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vhow123/dsh-cost-forecast.git"
  },
  "homepage": "https://github.com/Vhow123/dsh-cost-forecast",
  "bugs": {
    "url": "https://github.com/Vhow123/dsh-cost-forecast/issues"
  },
